# nfe2pdf configuration
# Copy this file to %APPDATA%\nfe2pdf\config.yaml and customize as needed
# Environment variables (prefix NFE2PDF_) take precedence over this file

danfe:
  # Layout: auto | nt_2026_010 | moc_7_0
  layout: "auto"

  # Logo path (absolute path to .png or .jpg)
  # logo: "C:\\path\\to\\logo.png"

  # Margins in millimeters
  margins:
    top: 5.0
    right: 5.0
    bottom: 5.0
    left: 5.0

  # Font: times | courier
  font_type: "times"

  # Font size: small | big
  font_size: "small"

  # Tax configuration: standard_icms_ipi | icms_st | without_ipi
  tax_configuration: "standard_icms_ipi"

  # Invoice display: full_details | duplicates_only
  invoice_display: "full_details"

  # Display PIS/COFINS columns
  display_pis_cofins: false

  # Show "CANCELADA" watermark on cancelled NF-e
  watermark_cancelled: true

  # Convert semicolons to newlines in complementary info
  infcpl_semicolon_newline: false

  # Receipt position: top | bottom | left
  receipt_position: "top"

  # Include carrier receipt
  carrier_receipt: false

  # Footer text (optional)
  footer_text: ""

  # Footer logo (optional)
  # footer_logo: "C:\\path\\to\\footer_logo.png"

  # Footer height in mm
  footer_height: 5.0

  # Footer logo max width in mm
  footer_logo_max_width: 20.0

  # Footer spacing in mm
  footer_spacing: 1.0

logging:
  # Log level: DEBUG | INFO | WARNING | ERROR
  level: "INFO"

  # Log file (null = console only)
  file: null

  # Log rotation
  rotation: "10 MB"

  # Log retention
  retention: "7 days"

output:
  # Default output directory for PDFs (null = same dir as XML)
  default_dir: null

  # Overwrite existing PDF without asking
  overwrite: false